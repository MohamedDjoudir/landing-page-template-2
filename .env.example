# Every value here is optional. Copy this file to .env.local to change one; the
# NEXT_PUBLIC_* values are read when the app builds, so restart `yarn dev` or run
# `yarn build` again after a change.

# The public address of the site, used for the canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Base URL of an API that receives newsletter sign-ups. The form posts
# { "email": string } to `${NEXT_PUBLIC_API_BASE_URL}/newsletter/subscribe`.
# Left empty, the form sends nothing and shows its error message.
NEXT_PUBLIC_API_BASE_URL=
